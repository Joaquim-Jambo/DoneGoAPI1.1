                            }
                        }
                    },
                    "500": {
                        "description": "Falha ao listar as categorias",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorExample"
                        }
                    }
                }
            },
            "post": {
                "description": "Adiciona uma nova categoria à base de dados",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Categorias"
                ],
                "summary": "Cria uma nova categoria",
                "parameters": [
                    {
                        "description": "Dados da categoria",
